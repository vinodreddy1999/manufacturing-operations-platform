generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenancyStrategy { SHARED_DATABASE DEDICATED_DATABASE }
enum ModuleKey { INVENTORY WAREHOUSE SUPPLIER PROCUREMENT PRODUCTION BOM MAINTENANCE QUALITY CUSTOMERS CUSTOMER_PORTAL SUPPLIER_PORTAL FORECASTING COSTING AI_COPILOT }
enum InventoryCategory { RAW_MATERIALS WIP FINISHED_GOODS CONSUMABLES SPARE_PARTS }
enum TrackingType { NONE BATCH SERIAL BATCH_AND_SERIAL }
enum InventoryStatus { AVAILABLE RESERVED ALLOCATED IN_TRANSIT QUARANTINE REJECTED EXPIRED CONSUMED RETURNED DAMAGED }
enum MovementType { RECEIVING TRANSFER CONSUMPTION ADJUSTMENT WRITE_OFF RETURN DAMAGE SCRAP }
enum SupplierRole { PRIMARY BACKUP EMERGENCY }

model Tenant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  strategy       TenancyStrategy @default(SHARED_DATABASE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companies      Company[]
  users          User[]
  roles          Role[]
  featureFlags   FeatureFlag[]
  inventoryItems InventoryItem[]
  warehouses     Warehouse[]
  suppliers      Supplier[]
  auditEvents    AuditEvent[]
}

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plants    Plant[]
  @@unique([tenantId, code])
}

model Plant {
  id        String @id @default(cuid())
  tenantId  String
  companyId String
  name      String
  code      String
  timezone  String
  company   Company @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  @@unique([tenantId, code])
}

model Department {
  id       String @id @default(cuid())
  tenantId String
  plantId  String
  name     String
  code     String
  @@unique([tenantId, plantId, code])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  isActive     Boolean    @default(true)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]
  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]
  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model FeatureFlag {
  id        String    @id @default(cuid())
  tenantId  String
  moduleKey ModuleKey
  enabled   Boolean   @default(false)
  rules     Json?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, moduleKey])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId, userId])
}

model InventoryItem {
  id           String            @id @default(cuid())
  tenantId     String
  sku          String
  itemCode     String
  description  String
  uom          String
  category     InventoryCategory
  trackingType TrackingType
  costMethod   String
  reorderLevel Decimal @default(0)
  safetyStock  Decimal @default(0)
  leadTimeDays Int     @default(0)
  isActive     Boolean @default(true)
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  balances     InventoryBalance[]
  movements    InventoryMovement[]
  supplierItems SupplierItem[]
  @@unique([tenantId, sku])
  @@unique([tenantId, itemCode])
}

model InventoryBalance {
  id                String          @id @default(cuid())
  tenantId          String
  itemId            String
  locationId        String?
  batchNumber       String?
  status            InventoryStatus @default(AVAILABLE)
  physicalQuantity  Decimal         @default(0)
  reservedQuantity  Decimal         @default(0)
  allocatedQuantity Decimal         @default(0)
  incomingQuantity  Decimal         @default(0)
  item              InventoryItem   @relation(fields: [itemId], references: [id])
  location          WarehouseLocation? @relation(fields: [locationId], references: [id])
}

model InventoryMovement {
  id             String       @id @default(cuid())
  tenantId       String
  itemId         String
  movementType   MovementType
  quantity       Decimal
  fromLocationId String?
  toLocationId   String?
  reason         String?
  createdById    String
  createdAt      DateTime @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id])
}

model Warehouse {
  id        String @id @default(cuid())
  tenantId  String
  plantId   String
  code      String
  name      String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  plant     Plant  @relation(fields: [plantId], references: [id])
  locations WarehouseLocation[]
  @@unique([tenantId, code])
}

model WarehouseLocation {
  id          String @id @default(cuid())
  tenantId    String
  warehouseId String
  type        String
  code        String
  name        String
  capacity    Decimal?
  mapX        Decimal?
  mapY        Decimal?
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  balances    InventoryBalance[]
  @@unique([tenantId, warehouseId, code])
}

model Supplier {
  id                  String @id @default(cuid())
  tenantId            String
  name                String
  leadTimeDays        Int
  qualityRating       Decimal
  deliveryReliability Decimal
  tenant              Tenant @relation(fields: [tenantId], references: [id])
  contacts            SupplierContact[]
  items               SupplierItem[]
}

model SupplierContact {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String
  name       String
  email      String?
  phone      String?
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierItem {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String
  itemId     String
  role       SupplierRole
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])
  @@unique([tenantId, supplierId, itemId, role])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  reason     String?
  source     String
  ipAddress  String?
  device     String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}
